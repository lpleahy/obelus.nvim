# obelus ui snapshot: registration @ 80x24
## user commands (added by obelus)
ObelusAsk nargs="?" range="." bang=false complete=nil desc="obelus: ask a question about the line/selection (read-only)"
ObelusAskClear nargs="0" range=nil bang=false complete=nil desc="obelus: clear every ask thread"
ObelusBandStyle nargs="0" range=nil bang=false complete=nil desc="obelus: toggle thread display style (inline band | hover popup)"
ObelusBands nargs="0" range=nil bang=false complete=nil desc="obelus: toggle inline comment bands in this buffer"
ObelusCancel nargs="0" range=nil bang=false complete=nil desc="obelus: cancel the in-flight dispatch at cursor"
ObelusChat nargs="0" range=nil bang=false complete=nil desc="obelus: open the thread chat sidebar for the comment at cursor"
ObelusClear nargs="0" range=nil bang=false complete=nil desc="obelus: clear all comments"
ObelusComment nargs="0" range="." bang=false complete=nil desc="obelus: add a review comment"
ObelusContinue nargs="?" range=nil bang=false complete=nil desc="obelus: continue the open batch conversation (next round)"
ObelusDelete nargs="0" range=nil bang=false complete=nil desc="obelus: delete comment at cursor"
ObelusDispatch nargs="0" range=nil bang=false complete=nil desc="obelus: dispatch comment at cursor to a background agent"
ObelusDispatchAll nargs="?" range=nil bang=true complete=nil desc="obelus: dispatch every pending thread â€þX” one parallel agent each"
ObelusEdit nargs="0" range=nil bang=false complete=nil desc="obelus: edit comment at cursor"
ObelusEdits nargs="?" range=nil bang=false complete=<function> desc="obelus: toggle whether agents may apply edits (global; new agents only)"
ObelusHints nargs="0" range=nil bang=false complete=nil desc="obelus: toggle keybind hint footers"
ObelusImgClean nargs="0" range=nil bang=false complete=nil desc="obelus: delete .ai/img files unreferenced by any stored text"
ObelusJobs nargs="0" range=nil bang=false complete=nil desc="obelus: open the background-job output log"
ObelusList nargs="?" range=nil bang=false complete=<function> desc="obelus: open the review list"
ObelusLoad nargs="0" range=nil bang=false complete=nil desc="obelus: reload reviews from disk"
ObelusLogs nargs="0" range=nil bang=false complete=nil desc="obelus: open the run/error log (alias of :ObelusJobs)"
ObelusMode nargs="?" range=nil bang=false complete=<function> desc="obelus: toggle/set engagement mode (inline|sidebar)"
ObelusPanel nargs="0" range=nil bang=false complete=nil desc="obelus: toggle the review threads sidebar"
ObelusPerms nargs="?" range=nil bang=false complete=<function> desc="obelus: set (or cycle) the agent permission level â€þX” read-only | project-edit | unrestricted"
ObelusProject nargs="0" range=nil bang=false complete=nil desc="obelus: open the project thread (get-or-create)"
ObelusPrompt nargs="0" range=nil bang=false complete=nil desc="obelus: show the last prompt sent to the agent (verbatim)"
ObelusQuickReply nargs="0" range=nil bang=false complete=nil desc="obelus: quick reply to the thread at cursor (inline float)"
ObelusRenderInfo nargs="0" range=nil bang=false complete=nil desc="obelus: dump the renderer decision inputs for the chat/preview"
ObelusRenderer nargs="?" range=nil bang=false complete=<function> desc="obelus: set the chat markdown renderer (markview|builtin|treesitter|render-markdown|auto)"
ObelusReopen nargs="0" range=nil bang=false complete=nil desc="obelus: reopen comment at cursor"
ObelusResolve nargs="0" range=nil bang=false complete=nil desc="obelus: resolve comment at cursor"
ObelusRespond nargs="0" range=nil bang=false complete=nil desc="obelus: respond to the thread at cursor"
ObelusSave nargs="0" range=nil bang=false complete=nil desc="obelus: save reviews to disk"
ObelusSubmit nargs="?" range=nil bang=false complete=<function> desc="obelus: submit the review batch"
ObelusTag nargs="?" range=nil bang=false complete=<function> desc="obelus: tag/untag the thread at cursor (curates batch membership)"
ObelusTagMode nargs="?" range=nil bang=false complete=<function> desc="obelus: toggle sticky tagging mode (new threads inherit the tag)"
ObelusTagThread nargs="0" range=nil bang=false complete=nil desc="obelus: open the active tag's meta/batch thread (get-or-create)"
ObelusToggle nargs="?" range=nil bang=false complete=<function> desc="obelus: toggle annotations"
ObelusToggleResolved nargs="0" range=nil bang=false complete=nil desc="obelus: show/hide resolved comments"
## keymaps (global, added by obelus)
n <M-d> desc="obelus: thread down half-page" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n <M-u> desc="obelus: thread up half-page" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \o? desc="obelus: toggle keybind hints" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oA desc="obelus: active tag's meta/batch thread" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oB desc="obelus: toggle band/popup style" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oC desc="obelus: cancel dispatch at cursor" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oD desc="obelus: dispatch all in parallel (one agent each)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oE desc="obelus: cycle the agent permission level (global)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oG desc="obelus: toggle sticky tagging mode" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oI desc="obelus: clear every ask thread" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oJ desc="obelus: scroll thread down" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oK desc="obelus: scroll thread up" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oR desc="obelus: toggle resolved at cursor" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oS desc="obelus: force a new batch (even if one is open)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oT desc="obelus: toggle (global)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oX desc="obelus: clear all" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oa desc="obelus: project thread" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \ob desc="obelus: toggle inline bands" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oc desc="obelus: comment line" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \od desc="obelus: dispatch one (background)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oe desc="obelus: toggle agent edits (global)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \of desc="obelus: quick reply (inline float)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \og desc="obelus: tag/untag thread (batch group)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oh desc="obelus: show/hide resolved" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oi desc="obelus: ask about this line (read-only)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oj desc="obelus: job output log" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \ol desc="obelus: list" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \om desc="obelus: toggle inline/sidebar mode" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oo desc="obelus: open full thread (scrollable)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \op desc="obelus: toggle threads sidebar" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oq desc="obelus: quickfix" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \or desc="obelus: reply to thread at cursor" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \os desc="obelus: submit / continue batch (auto)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \ot desc="obelus: toggle (buffer)" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \ox desc="obelus: delete at cursor" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
n \oz desc="obelus: pin/collapse band" silent=0 noremap=1 nowait=0 expr=0 rhs="<lua>"
x \oc desc="obelus: comment selection" silent=1 noremap=1 nowait=0 expr=0 rhs=":<C-U>lua require('obelus').comment_visual()<CR>"
x \oi desc="obelus: ask about the selection (read-only)" silent=1 noremap=1 nowait=0 expr=0 rhs=":<C-U>lua require('obelus').ask_visual()<CR>"
