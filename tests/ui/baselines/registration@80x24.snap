## full after setup: autocmds (16)
nvim.cmdwin CmdwinEnter pattern="[:>]" buffer=-  once=false desc="Limit syntax sync to maxlines=1 in the command window" run="syntax sync minlines=1 maxlines=1"
nvim.popupmenu MenuPopup pattern="*" buffer=-  once=false desc="Mouse popup menu" run=<lua vim/_core/defaults>
nvim.swapfile SwapExists pattern="*" buffer=-  once=false desc="Skip the swapfile prompt when the swapfile is owned by a running Nvim process" run=<lua vim/_core/defaults>
nvim.terminal BufReadCmd pattern="term://*" buffer=-  once=false desc="Treat term:// buffers as terminal buffers" run="if !exists('b:term_title')|call jobstart(matchstr(expand(\"<amatch>\"), '\\c\\mterm://\\%(.\\{-}//\\%(\\d\\+:\\)\\?\\)\\?\\zs.*'), {'term': v:true, 'cwd': expand(get(matchlist(expand(\"<amatch>\"), '\\c\\mterm://\\(.\\{-}\\)//'), 1, ''))})"
nvim.terminal TermClose pattern="*" buffer=-  once=false desc="Automatically close terminal buffers when started with no arguments and exiting without an error" run=<lua vim/_core/defaults>
nvim.terminal TermClose pattern="*" buffer=-  once=false desc="Displays the \"[Process exited]\" virtual text" run=<lua vim/_core/defaults>
nvim.terminal TermOpen pattern="*" buffer=-  once=false desc="Default settings for :terminal buffers" run=<lua vim/_core/defaults>
nvim.terminal TermRequest pattern="*" buffer=-  once=false desc="Handles OSC foreground/background color requests" run=<lua vim/_core/defaults>
