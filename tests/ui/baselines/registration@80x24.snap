ObelusDispatch  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: dispatch comment at cursor to a background agent"
ObelusDispatchAll  nargs="?" range=nil count=nil bang=true bar=false complete=nil def="obelus: dispatch every pending thread â€þX” one parallel agent each"
ObelusEdit  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: edit comment at cursor"
ObelusEdits  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: toggle whether agents may apply edits (global; new agents only)"
ObelusHints  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: toggle keybind hint footers"
ObelusImgClean  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: delete .ai/img files unreferenced by any stored text"
ObelusJobs  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: open the background-job output log"
ObelusList  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: open the review list"
ObelusLoad  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: reload reviews from disk"
ObelusLogs  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: open the run/error log (alias of :ObelusJobs)"
ObelusMode  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: toggle/set engagement mode (inline|sidebar)"
ObelusPanel  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: toggle the review threads sidebar"
ObelusPerms  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: set (or cycle) the agent permission level â€þX” read-only | project-edit | unrestricted"
ObelusProject  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: open the project thread (get-or-create)"
ObelusPrompt  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: show the last prompt sent to the agent (verbatim)"
ObelusQuickReply  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: quick reply to the thread at cursor (inline float)"
ObelusRenderInfo  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: dump the renderer decision inputs for the chat/preview"
ObelusRenderer  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: set the chat markdown renderer (markview|builtin|treesitter|render-markdown|auto)"
ObelusReopen  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: reopen comment at cursor"
ObelusResolve  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: resolve comment at cursor"
ObelusRespond  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: respond to the thread at cursor"
ObelusSave  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: save reviews to disk"
ObelusSubmit  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: submit the review batch"
ObelusTag  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: tag/untag the thread at cursor (curates batch membership)"
ObelusTagMode  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: toggle sticky tagging mode (new threads inherit the tag)"
ObelusTagThread  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: open the active tag's meta/batch thread (get-or-create)"
ObelusToggle  nargs="?" range=nil count=nil bang=false bar=false complete="<fn>" def="obelus: toggle annotations"
ObelusToggleResolved  nargs="0" range=nil count=nil bang=false bar=false complete=nil def="obelus: show/hide resolved comments"
Open  nargs="1" range=nil count=nil bang=false bar=false complete="file" def="Open file with system default handler. See :help vim.ui.open()"
