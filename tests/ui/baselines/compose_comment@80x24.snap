|local M = {}                                                                    |
|                                                                                |
|local function clamp(x, lo, hi)                                                 |
|  if x < lo then                                                                |
|    return lo                                                                   |
|  end                                                                           |
|  return math.min(x, hi)                                                        |
|end                                                                             |
|                                                                                |
|function M.scale(values, factor)                                                |
|  local out = {}                                                                |
|  for i, v in ipairs(values) do                                                 |
|    out[i] = clamp(v * factor, 0, 100)                                          |
