|                                                                                                                                                                |
|  function M.scale(values, factor)                                                                                                                              |
|    local out = {}                                                                                                                                              |
|    for i, v in ipairs(values) do                                                                                                                               |
|      out[i] = clamp(v * factor, 0, 100)                                                                                                                        |
|    end                                                                                                                                                         |
|    return out                                                                                                                                                  |
|  end                                                                                                                                                           |
|                                                                                                                                                                |
|  function M.sum(values)                                                                                                                                        |
|    local total = 0                                                                                                                                             |
|    for _, v in ipairs(values) do                                                                                                                               |
|      total = total + v                                                                                                                                         |
|    end                                                                                                                                                         |
|    return total                                                                                                                                                |
|  end                                                                                                                                                           |
|                                                                                                                                                                |
|  return M                                                                                                                                                      |
