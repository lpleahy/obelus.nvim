|  -- sample.lua: a small module the fixtures annotate                                       │ ◆ obelus review                                                   |
|  local M = {}                                                                              │  ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄  |
|                                                                                            │▎ agent ↩                                                          |
|  local function clamp(x, lo, hi)                                                           │▎ It is intended for inputs, but factor itself is never            |
|    if x < lo then                                                                          │▎ checked.                                                         |
|      return lo                                                                             │  ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄  |
|    end                                                                                     │▎ you                                                              |
|    return math.min(x, hi)                                                                  │▎ so what happens with factor = -2? see @sample.lua                |
|  end                                                                                       │  ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄  |
|                                                                                            │▎ agent ↩                                                          |
|▌ function M.scale(values, factor)                                                          │▎ Good catch. clamp is applied after the multiply, so a            |
|▌   local out = {}                                                                          │▎ negative factor silently                                         |
|▌   for i, v in ipairs(values) do                                                           │▎ maps every value to 0 instead of raising. Two options:           |
|      out[i] = clamp(v * factor, 0, 100)                                                    │▎                                                                  |
|    end                                                                                     │▎ 1. Validate factor up front and error() on a negative            |
|    return out                                                                              │▎    value.                                                        |
|  end                                                                                       │▎ 2. Clamp the input first, then scale — this keeps the            |
|                                                                                            │▎    contract but changes rounding.                                |
|  function M.sum(values)                                                                    │▎                                                                  |
|    local total = 0                                                                         │▎ function M.scale(values, factor)                           lua   |
|    for _, v in ipairs(values) do                                                           │▎   assert(factor >= 0, "factor must be non-negative")             |
|      total = total + v                                                                     │▎   local out = {}                                                 |
|    end                                                                                     │▎   for i, v in ipairs(values) do                                  |
|    return total                                                                            │▎     out[i] = clamp(v * factor, 0, 100)                           |
|  end                                                                                       │▎   end                                                            |
|                                                                                            │▎   return out                                                     |
|  return M                                                                                  │▎ end                                                              |
|~                                                                                           │▎                                                                  |
|~                                                                                           │▎ ╭─────────────┬───────────────────┬──────╮                       |
|~                                                                                           │▎ │ option      │ breaks callers    │ cost │                       |
|~                                                                                           │▎ ├─────────────┼───────────────────┼──────┤                       |
|~                                                                                           │▎ │ validate    │ yes, on bad input │ O(1) │                       |
|~                                                                                           │▎ │ clamp first │ no                │ O(n) │                       |
|~                                                                                           │▎ ╰─────────────┴───────────────────┴──────╯                       |
|~                                                                                           │▎                                                                  |
|~                                                                                           │▎ │ I'd go with option 1: it fails loudly, which matches           |
|~                                                                                           │▎ M.sum's behaviour.                                               |
